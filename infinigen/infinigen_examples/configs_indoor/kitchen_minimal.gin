# Minimal Kitchen Configuration
# Spawns: counters (with hob + range hood), sink + deck mixer
# NO fridge / oven / dishwasher / counter clutter

# Photo-like lighting, materials and compositing, same as the dry-room configs.
include 'infinigen_examples/configs_indoor/realism_v2.gin'

# Use single room configuration
BlueprintSolidifier.enable_open=False

# Restrict to kitchen room type
restrict_solving.solve_max_rooms=1
restrict_solving.restrict_parent_rooms=["Kitchen"]

# Don't restrict primary/secondary children - let the constraint graph do it
# Instead, we filter the constraint graph to only kitchen counter constraints

# Filter constraint graph to ONLY kitchen counter/island/sink constraints
# This removes kitchen_appliance, kitchen_barchairs, and counter clutter
# Keeps: kitchen_counters, kitchen_island_placement, kitchen_sink
# Also keeps: defects, AC, wall plugs, light switches
restrict_solving.consgraph_filters=["kitchen_counter", "kitchen_island", "kitchen_sink", "kitchen_appliance", "cracks", "paint_peel", "wall_bubbles", "paint_runs", "paint_patches", "weak_leak_stain", "ceiling_lights", "ac_units", "wall_plugs", "light_switches"]

# No island: a flat kitchen has nowhere to put one (the placement rule needs
# >2 m of clear floor all round), so every large-solve step was spent proposing
# an island and rejecting it at ~30 s a go - most of a ~50 minute coarse pass.
home_furniture_constraints.kitchen_island_enabled = False

# Built-in oven only. A flat is handed over with the cooking appliances fitted;
# the fridge, dishwasher and microwave come with whoever moves in.
home_furniture_constraints.kitchen_oven_enabled = True
home_furniture_constraints.kitchen_dishwasher_enabled = False
home_furniture_constraints.kitchen_fridge_enabled = False
home_furniture_constraints.kitchen_microwave_enabled = False

# Disable terrain and other features
compose_indoors.terrain_enabled = False
compose_indoors.hide_other_rooms_enabled = True

# Disable solving stages we don't need
compose_indoors.solve_small_enabled = True   # Kitchen sink + mixer on the counter
compose_indoors.solve_medium_enabled = True   # Enable for wall decorations (defect planes)
compose_indoors.solve_large_enabled = True

# Extras
compose_indoors.lights_off_chance = 0.0
compose_indoors.skirting_floor_chance = 1.0
compose_indoors.skirting_ceiling_chance = 0.3

# Door settings - make ALL doors completely closed
populate_doors.all_closed = True
populate_doors.door_chance = 1.0

# Fast solve
# FloorPlanSolver.n_divide_trials = 25
# FloorPlanSolver.iters_mult = 25
# home_room_constraints.has_fewer_rooms = True
# solve_objects.addition_weight_scalar = 3.0
# compose_indoors.solve_steps_large = 100
# compose_indoors.solve_steps_medium = 40
# compose_indoors.solve_steps_small = 5


# 4:3 smartphone still (must match realism_v2.gin / get_sensor_coords)
execute_tasks.generate_resolution = (1920, 1440)
get_sensor_coords.H = 1440
get_sensor_coords.W = 1920