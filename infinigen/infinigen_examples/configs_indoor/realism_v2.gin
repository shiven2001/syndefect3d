# SynDefect3D realism v2 — phone-like indoor defect renders.
# bedroom / dining / livingroom _minimal.gin now `include` this file, so those
# rooms get the photo look with no extra flag. Still safe to pass by hand with
# -g for other configs (kitchen, bathroom, studio_apartment, defect_render).
#
# Coarse (new scenes / new defect-focus rigs):
#   python -m infinigen_examples.generate_indoors --task coarse \
#     -g bedroom_minimal.gin realism_v2.gin \
#     --overrides camera.spawn_camera_rigs.n_camera_rigs=10
#
# Indoor runs do not need terrain libs. Keep terrain off even if bedroom_minimal
# is omitted (a second -g used to drop the first argparse value).
#
# Render (existing or new blends) — this is what writes iPhone-like PNGs:
#   python -m infinigen_examples.generate_indoors --seed 4 --task render \
#     --input_folder outputs/dataset/livingroom_v25 \
#     --output_folder outputs/dataset/livingroom_v25/frames \
#     -g livingroom_minimal.gin defect_render.gin \
#     -p execute_tasks.camera_id=\[0,0\]
#
# See REALISM_IMPROVEMENTS.md for validation and pilot re-render workflow.

# --- Lighting ---
# Compositor Exposure +1 EV over film 1.0 is the inspection-photo overexpose
# (windows blow, AgX rolls highlights). Saturation stays near 1.0: the real
# set's mean saturation of 16-20 comes from close-up crops of painted wall.
configure_render_cycles.exposure = 1.0
nishita_lighting.strength = 0.24
nishita_lighting.sun_elevation = ("clip_gaussian", 22, 10, 8, 40)
# The sun subtends ~0.53 deg. Nishita treats sunlight as a parallel beam for
# exactly that reason; 2.4 deg was an unphysical softening.
nishita_lighting.sun_size_deg = ("clip_gaussian", 0.53, 0.06, 0.45, 0.75)
nishita_lighting.sun_intensity = ("uniform", 0.55, 0.75)
nishita_lighting.air_density = ("clip_gaussian", 1.15, 0.15, 0.85, 1.4)
nishita_lighting.dust_density = ("clip_gaussian", 1.35, 0.25, 0.8, 2.0)
# No extra sun lamps. Nishita already carries both daylight terms - direct
# attenuated sunlight and integrated sky light - so an added lamp is a second
# sun in a sky that has one, from an azimuth (2*pi*i/n, i.e. 0 for n=1) that is
# unrelated to where the sky's sun is. Measured: removing it moved mean
# brightness by 0.8, while the window's mullion shadow came back.
add_multi_directional_sun_lighting.n_directions = 0
add_multi_directional_sun_lighting.elevation_deg = 28.0
add_multi_directional_sun_lighting.energy_per_sun = 1.6
add_multi_directional_sun_lighting.sun_angle_deg = 0.53
# Procedural Nishita sky through windows (not Poly Haven HDRI).
sky_lighting.add_lighting.mode = "nishita"
compose_indoors.lights_off_chance = 0.0
compose_indoors.terrain_enabled = False
populate_doors.all_closed = True
populate_doors.door_chance = 1.0
populate_doors.n_doors = 1
populate_windows.n_windows = 1

# iPhone 11 wide: 5.6 mm sensor, 3.7 mm lens (~74 deg HFOV). Not 35 mm-equivalent.
# New coarse recommended so pose search uses this FOV; render also applies it.
camera.adjust_camera_sensor.sensor_width = 5.6
camera.configure_smartphone_optics.enabled = True
camera.configure_smartphone_optics.focal_length = 3.7
camera.configure_smartphone_optics.use_dof = True
camera.configure_smartphone_optics.aperture_fstop = 1.8
camera.configure_smartphone_optics.focus_distance = 2.0
camera.camera_pose_proposal.focal_length = 3.7

# On-camera flash flattens wide rooms. Leave off; defect close-ups can override.
add_camera_based_lighting.enabled = False

# Render-time photo look (also applies to existing blends)
apply_realism_adjustments.refresh_room_surfaces = True
dull_interior_floors.enabled = True
soften_existing_lights.enabled = True
soften_existing_lights.sun_angle_deg = 0.53
# Blends coarsed before n_directions went to 0 still carry their sun lamps;
# zeroing the energy here makes an old blend render like a new one.
soften_existing_lights.sun_energy = 0.0
configure_photo_cycles.enabled = True
# Blender 4.x names the AgX looks with the transform prefix - "Base Contrast"
# on its own is not a valid enum value and is rejected.
configure_photo_cycles.view_transform = "AgX"
configure_photo_cycles.look = "AgX - Base Contrast"
restore_ceiling_fixture_visibility.enabled = True

# --- Defect cameras (must be set at coarse time for new rigs) ---
camera.add_defect_focus.enabled = True
camera.pose_defect_cameras.distance = 0.9
camera.pose_defect_cameras.focal_length = 3.7
camera.pose_defect_cameras.height_jitter = 0.08
camera.pose_defect_cameras.horizontal_jitter = 0.12
camera.pose_defect_cameras.angle_noise_deg = 6

# --- Render / materials ---
# 4:3 smartphone still (iPhone / Android). Crop/scale to 640 or 1024 at export.
execute_tasks.generate_resolution = (1920, 1440)
get_sensor_coords.H = 1440
get_sensor_coords.W = 1920

set_displacement_mode.displacement_mode = "BOTH"
configure_render_cycles.num_samples = 1024
configure_render_cycles.denoise = True

# Deep focus (tiny sensor + f/1.8). Motion blur shutter 0.1 = crisp daylight phone.
render_image.use_dof = True
render_image.dof_aperture_fstop = 1.8
defect/render_image.use_dof = True
defect/render_image.dof_aperture_fstop = 1.8
configure_blender.motion_blur = True
configure_blender.motion_blur_shutter = 0.1

# Extra dry-room wall/ceiling pull toward grey (tiles in kitchen/bathroom are skipped)
desaturate_surface_materials.saturation_scale = 0.70
desaturate_surface_materials.skip_wet_rooms = True

# Builder-grade plaster (already default in plaster.py; listed for override)
plaster_paint_params.colored_prob = 0.0
plaster_paint_params.max_saturation = 0.04

# Write Use Nodes + Viewer into scene.blend so the Compositing tab is not empty.
bake_phone_compositor.enabled = True

# --- Compositor: iPhone 11 still, not FPV camcorder ---
# Phones computationally undo CA and keep HDR; only a hint of glow/sharpen/grain.
compositor_postprocessing.exposure = 0.25
compositor_postprocessing.color_correct = True
compositor_postprocessing.contrast = 1.04
compositor_postprocessing.bright = 1.0
compositor_postprocessing.saturation = 0.98
compositor_postprocessing.vignette = 0.0
compositor_postprocessing.glare = True
compositor_postprocessing.glare_stack = [
    {"glare_type": "FOG_GLOW", "quality": "HIGH", "mix": -0.92, "threshold": 0.70, "size": 6},
]
compositor_postprocessing.distort = 0.008
compositor_postprocessing.dispersion = 0.004
compositor_postprocessing.sharpen = 0.28
compositor_postprocessing.sharpen_type = "SHARPEN_DIAMOND"
compositor_postprocessing.grain = 0.02

# --- Micro-detail: edge bevels + surface imperfection (render-time) ---
# Perfectly sharp edges and one flat roughness per surface are the two
# geometric/shading CGI tells left after the tonal work above. Both passes run
# from apply_realism_adjustments, so existing blends pick them up on re-render.
# 2 mm at 3 segments is a painted-arris highlight, not a visible chamfer.
add_edge_bevels.enabled = True
add_edge_bevels.width = 0.002
add_edge_bevels.segments = 3
add_edge_bevels.angle_deg = 30.0
# Dense assets: a 2 mm chamfer is sub-pixel but the geometry is not free.
add_edge_bevels.max_polygons = 100000
# Defect planes are the label - never move their geometry.
add_edge_bevels.skip_defects = True

apply_surface_imperfections.enabled = True
apply_surface_imperfections.strength = 0.06
apply_surface_imperfections.scale = 6.0
# Skips defect shaders (the signal) and glass (would frost the windows).
apply_surface_imperfections.skip_defects = True
apply_surface_imperfections.skip_transmissive = True
