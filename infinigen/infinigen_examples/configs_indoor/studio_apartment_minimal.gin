# Compact studio apartment (living + bedroom + bath + dining + kitchen + entrance)
# with per-room minimal furnishing — one connected multi-room scene.
#
# Unlike *_minimal.gin, this does NOT restrict to a single room type.
# Do not combine with singleroom.gin or restrict_solving.restrict_parent_rooms.
#
# Per room (via consgraph_filters):
#   Living / bedroom / dining — shell + defects + ceiling lights + AC + wall plugs only
#   Kitchen — counters, island, sink + built-ins (no appliances / bar chairs)
#   Bathroom — toilet, sink, mirror, bathtub, shower, vanity, exhaust, drain, TP, medicine + faucets

# Photo-like lighting, materials and compositing, same as the dry-room configs.
include 'infinigen_examples/configs_indoor/realism_v2.gin'

# Compact floor plan (same as studio.gin / fast_solve.gin)
home_room_constraints.has_fewer_rooms = True
# 25/25 leaves the per-room area objective far from converged - bathrooms came
# out at 190 m2 against an 8 m2 target, which is what scattered their fixtures.
FloorPlanSolver.n_divide_trials = 100
FloorPlanSolver.iters_mult = 200
solve_objects.addition_weight_scalar = 3.0

compose_indoors.solve_steps_large = 100
# 40 left the wall stage with violations: sockets at 1.5 m, switches at 2.3 m.
compose_indoors.solve_steps_medium = 200
# 5 could not place small wall items at all - paper holders and mixers were
# simply left out of finished bathrooms.
compose_indoors.solve_steps_small = 30

# No island: nowhere in a studio has the >2 m clearance its placement rule
# needs, so every large step was spent proposing one and rejecting it.
home_furniture_constraints.kitchen_island_enabled = False

compose_indoors.terrain_enabled = False
compose_indoors.hide_other_rooms_enabled = False

# Union of per-room minimal consgraph filters (substring match on constraint keys)
restrict_solving.consgraph_filters=["ceiling_lights", "cracks", "paint_peel", "wall_bubbles", "paint_runs", "paint_patches", "weak_leak_stain", "ac_units", "wall_plugs", "light_switches", "faucets", "kitchen_counter", "kitchen_island", "kitchen_sink", "bathroom", "toilet", "bathtub", "showers", "vanities", "exhaust_fans", "floor_drains", "medicine_cabinets", "toilet_paper"]

compose_indoors.solve_small_enabled = True
compose_indoors.solve_medium_enabled = True
compose_indoors.solve_large_enabled = True

compose_indoors.lights_off_chance = 0.0
compose_indoors.skirting_floor_chance = 1.0
compose_indoors.skirting_ceiling_chance = 1.0
populate_doors.door_chance = 1.0
populate_doors.all_closed = True

# 4:3 smartphone still (must match realism_v2.gin / get_sensor_coords)
execute_tasks.generate_resolution = (1920, 1440)
get_sensor_coords.H = 1440
get_sensor_coords.W = 1920
