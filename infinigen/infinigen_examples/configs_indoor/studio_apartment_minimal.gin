# Compact studio apartment (living + bedroom + bath + dining + kitchen + entrance)
# with per-room minimal furnishing — one connected multi-room scene.
#
# Unlike *_minimal.gin, this does NOT restrict to a single room type.
# Do not combine with singleroom.gin or restrict_solving.restrict_parent_rooms.
#
# Per room (via consgraph_filters):
#   Living / bedroom / dining — shell + defects + ceiling lights + AC + wall plugs only
#   Kitchen — counters, island, sink + built-ins (no appliances / bar chairs)
#   Bathroom — toilet, sink, mirror, bathtub + faucets (no shelves / clutter)

# Compact floor plan (same as studio.gin / fast_solve.gin)
home_room_constraints.has_fewer_rooms = True
FloorPlanSolver.n_divide_trials = 25
FloorPlanSolver.iters_mult = 25
solve_objects.addition_weight_scalar = 3.0

compose_indoors.solve_steps_large = 100
compose_indoors.solve_steps_medium = 40
compose_indoors.solve_steps_small = 5

compose_indoors.terrain_enabled = False
compose_indoors.hide_other_rooms_enabled = False

# Union of per-room minimal consgraph filters (substring match on constraint keys)
restrict_solving.consgraph_filters=["ceiling_lights", "cracks", "paint_peel", "spalling", "spalling_plug", "wall_bubbles", "weak_leak_stain", "open_wiring", "ac_units", "wall_plugs", "faucets", "kitchen_counter", "kitchen_island", "kitchen_sink", "kitchen_objects", "bathroom", "toilet", "bathtub"]

compose_indoors.solve_small_enabled = False
compose_indoors.solve_medium_enabled = True
compose_indoors.solve_large_enabled = True

compose_indoors.lights_off_chance = 0.0
compose_indoors.skirting_floor_chance = 1.0
compose_indoors.skirting_ceiling_chance = 1.0
populate_doors.door_chance = 1.0
populate_doors.all_closed = True

execute_tasks.generate_resolution = (1024, 1024)
get_sensor_coords.H = 1024
get_sensor_coords.W = 1024
